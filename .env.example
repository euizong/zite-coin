# 환경별 설정 파일 예시 (mainnet, testnet)

NODE_ENV=development
NETWORK=mainnet # 또는 testnet

# RPC 엔드포인트
RPC_URL_MAINNET=https://polygon-rpc.com
RPC_URL_TESTNET=https://rpc-mumbai.maticvigil.com

# 지갑 주소 (메인넷/테스트넷 별도)
WALLET_ADDRESS_MAINNET=0x45dADA5B52605828c135469C048A1e14189BBF42
WALLET_ADDRESS_TESTNET=0x0987654321098765432109876543210987654321

# 퍼블릭키 (메인넷/테스트넷 별도)
PUBLIC_KEY_MAINNET=3a8f027875279fd21bbc54b9f4093e375135454c73c56b70ac48b5ab3f408355
PUBLIC_KEY_TESTNET=your_testnet_public_key_here

# 토큰 컨트랙트 주소 (메인넷/테스트넷 별도)
TOKEN_CONTRACT_ADDRESS_MAINNET=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
TOKEN_CONTRACT_ADDRESS_TESTNET=0xfedcbafedcbafedcbafedcbafedcbafedcbafedcba

# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_USER=youruser
DB_PASS=yourpass
DB_NAME=yourdb

# JWT 시크릿
JWT_SECRET=your_jwt_secret
